---
import BaseLayout from '@/layouts/BaseLayout.astro'
import siteConfig from '@/site-config'
import TypedText from '@/components/TypedText.vue'

const funFacts = [
  '🚀 D365FO Dev | Software Engineer',
  'I use Nvim + NixOS, btw 😎',
  'Blue is the colour, Chelsea FC 💙',
]
---

<BaseLayout description={siteConfig.description}>
  <article class="prose lg:prose-xl">
    <p class="mt-4 text-lg">
      <b class="text-2xl text-white-600">{siteConfig.author}</b>
      <br />
      <b class="text-sm text-white-300">@hidayattaufiqur</b>
    </p>

    <p class="mt-4 text-md">
      <TypedText
        client:load
        messages={funFacts}
        type-speed={55}
        delete-speed={28}
        pause-time={1500}
        between-pause={2000}
        aria-label="Fun facts about me"
      />
    </p>

    <p class="mt-6 text-lg">
      I'm a <b>Software Engineer</b> with <b>3+ years</b> of experience working as an
      <b>Associate Technical Consultant</b>, specializing in <b>backend engineering</b>,
      <b>ERP development</b>, and system design. I graduated <b>Cum Laude</b> in Computer Science from Telkom University.
      I'm also a notoriously brutal Mobile Legends jungler. I charge forward with Leo and Barbiel's raw strength, glide with
      Benedetta's finesse and elegance, then hit and run in Gusion's Minato skin.
    </p>

    <p class="mt-4 text-lg">
      I care about <b>backend architecture</b>, <b>distributed systems</b>, and
      <b>DevOps practices</b> that keep services fast and observable. Outside work: Mobile Legends, movies, music, guitar,
      Valorant, and endless tinkering with my dev environment, plus a crew of AI agents I've taught to automate the stuff
      I'm too lazy to do.
    </p>

    <!-- Technologies / Toolbox Section -->
    <section class="mt-10 not-prose">
      <h3 class="text-xl font-bold mb-4">Technologies I work with</h3>
      <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-6 gap-1">
        <span class="flex items-center p-2 rounded hover:bg-truegray-100 dark:hover:bg-truegray-800 transition-colors">
          <i class="i-simple-icons-typescript text-xl mr-2"></i>TypeScript
        </span>
        <span class="flex items-center p-2 rounded hover:bg-truegray-100 dark:hover:bg-truegray-800 transition-colors">
          <i class="i-simple-icons-javascript text-xl mr-2"></i>JavaScript
        </span>
        <span class="flex items-center p-2 rounded hover:bg-truegray-100 dark:hover:bg-truegray-800 transition-colors">
          <i class="i-simple-icons-go text-xl mr-2"></i>Golang
        </span>
        <span class="flex items-center p-2 rounded hover:bg-truegray-100 dark:hover:bg-truegray-800 transition-colors">
          <i class="i-simple-icons-python text-xl mr-2"></i>Python
        </span>
        <span class="flex items-center p-2 rounded hover:bg-truegray-100 dark:hover:bg-truegray-800 transition-colors">
          <i class="i-simple-icons-nodedotjs text-xl mr-2"></i>Node.js
        </span>
        <span class="flex items-center p-2 rounded hover:bg-truegray-100 dark:hover:bg-truegray-800 transition-colors">
          <i class="i-simple-icons-openjdk text-xl mr-2"></i>Java
        </span>
        <span class="flex items-center p-2 rounded hover:bg-truegray-100 dark:hover:bg-truegray-800 transition-colors">
          <i class="i-simple-icons-postgresql text-xl mr-2"></i>PostgreSQL
        </span>
        <span class="flex items-center p-2 rounded hover:bg-truegray-100 dark:hover:bg-truegray-800 transition-colors">
          <i class="i-simple-icons-mysql text-xl mr-2"></i>MySQL
        </span>
        <span class="flex items-center p-2 rounded hover:bg-truegray-100 dark:hover:bg-truegray-800 transition-colors">
          <i class="i-simple-icons-mongodb text-xl mr-2"></i>MongoDB
        </span>
        <span class="flex items-center p-2 rounded hover:bg-truegray-100 dark:hover:bg-truegray-800 transition-colors">
          <i class="i-simple-icons-redis text-xl mr-2"></i>Redis
        </span>
        <span class="flex items-center p-2 rounded hover:bg-truegray-100 dark:hover:bg-truegray-800 transition-colors">
          <i class="i-simple-icons-googlecloud text-xl mr-2"></i>GCP
        </span>
        <span class="flex items-center p-2 rounded hover:bg-truegray-100 dark:hover:bg-truegray-800 transition-colors">
          <i class="i-simple-icons-docker text-xl mr-2"></i>Docker
        </span>
        <span class="flex items-center p-2 rounded hover:bg-truegray-100 dark:hover:bg-truegray-800 transition-colors">
          <i class="i-simple-icons-nixos text-xl mr-2"></i>NixOS
        </span>
        <span class="flex items-center p-2 rounded hover:bg-truegray-100 dark:hover:bg-truegray-800 transition-colors">
          <i class="i-simple-icons-nginx text-xl mr-2"></i>Nginx
        </span>
        <span class="flex items-center p-2 rounded hover:bg-truegray-100 dark:hover:bg-truegray-800 transition-colors">
          <i class="i-simple-icons-microsoft text-xl mr-2"></i>D365FO
        </span>
        <span class="flex items-center p-2 rounded hover:bg-truegray-100 dark:hover:bg-truegray-800 transition-colors">
          <i class="i-simple-icons-neovim text-xl mr-2"></i>Neovim
        </span>
        <span class="flex items-center p-2 rounded hover:bg-truegray-100 dark:hover:bg-truegray-800 transition-colors">
          <i class="i-simple-icons-notion text-xl mr-2"></i>Notion
        </span>
        <span class="flex items-center p-2 rounded hover:bg-truegray-100 dark:hover:bg-truegray-800 transition-colors">
          <i class="i-ri-github-line text-xl mr-2"></i>GitHub
        </span>
      </div>
    </section>

    <!-- Featured Project Section -->
    <section class="mt-12 not-prose">
      <h3 class="text-xl font-bold mb-4">Featured project</h3>
      <div class="container-link rounded-xl p-4 max-w-2xl">
        <div class="flex items-start gap-3">
          <i class="i-carbon-enterprise text-3xl mt-1 flex-shrink-0"></i>
          <div class="min-w-0">
            <a
              href="/projects/fno-navigator-case-study"
              class="nav-link no-underline"
              aria-label="FnO Navigator — D365FO Process Navigator"
            >
              <span class="font-bold text-lg text-link text-wrap">
                FnO Navigator — D365FO Process Navigator
                <span class="text-sm font-normal opacity-60 ml-1">↗</span>
              </span>
            </a>
            <div class="opacity-70 text-sm mt-1 leading-relaxed">
              Static SvelteKit app for navigating Dynamics 365 Finance &amp; Operations: trace business processes,
              explore table relations, and find FK paths across the full 5,633-table database graph. Live &amp; open
              source.
            </div>
            <div class="flex gap-x-4 gap-y-1 flex-wrap mt-2 text-sm">
              <a
                href="https://fno.hidayattaufiqur.dev"
                target="_blank"
                rel="noreferrer"
                class="prose-link"
                aria-label="FnO Navigator live app">Live app</a
              >
              <a
                href="https://github.com/hidayattaufiqur/fno-interactor"
                target="_blank"
                rel="noreferrer"
                class="prose-link"
                aria-label="FnO Navigator source on GitHub">Source on GitHub</a
              >
              <a href="/projects/fno-navigator-case-study" class="prose-link" aria-label="FnO Navigator case study"
                >Case study</a
              >
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-12">
      <p class="text-lg">Let's connect:</p>
      <div class="flex gap-x-4 gap-y-2 flex-wrap mt-4">
        {
          siteConfig.socialLinks.map((link) => (
            <a
              aria-label={link.text}
              href={link.href}
              target="_blank"
              class="prose-link text-blue-500 hover:text-blue-700 transition-colors duration-200 flex items-center p-2 rounded hover:bg-gray-100 dark:hover:bg-gray-700"
            >
              <i class:list={[link.icon]} class="text-xl mr-2" />
              {link.text}
            </a>
          ))
        }
      </div>
      <p class="mt-8 text-lg">
        Or email me at
        <a
          class="text-blue-500 hover:text-blue-700 transition-colors duration-200"
          aria-label={siteConfig.email}
          href={`mailto:${siteConfig.email}`}
        >
          {siteConfig.email}
        </a>
      </p>
    </section>
  </article>
</BaseLayout>
