---
import BaseLayout from '@/layouts/BaseLayout.astro'
import siteConfig from '@/site-config'
import TypedText from '@/components/TypedText.vue'

const funFacts = [
  '🚀 Associate Technical Developer',
  'I use Nvim + NixOS, btw 😎',
  'Blue is the colour — Chelsea FC 💙',
]
---

<BaseLayout description={siteConfig.description}>
  <article class="prose lg:prose-xl">
    <p class="mt-4 text-lg">
      Greetings! My name is
      <b>Hidayat Taufiqur</b>
    </p>

    <p class="mt-4 text-md">
      <TypedText
        client:load
        messages={funFacts}
        type-speed={55}
        delete-speed={28}
        pause-time={1500}
        between-pause={2000}
        aria-label="Fun facts about me"
      />
    </p>

    <p class="mt-6 text-lg">
      I'm a <b>Software Engineer</b> with <b>3+ years</b> of experience, currently working as an <b
        >Associate Technical Developer</b
      > in ERP development. I specialize in <b>backend engineering</b> and system design — building APIs, integrating services,
      and automating workflows. I graduated <b>Cum Laude</b>
      in Computer Science from Telkom University (GPA 3.76 / 4.00).
    </p>

    <p class="mt-4 text-lg">
      I care about <b>backend architecture</b>, <b>distributed systems</b>, and
      <b>DevOps practices</b> that keep services fast and observable. Outside work: movies, music, guitar, ML/Valorant, and
      endless tinkering with my dev environment.
    </p>

    <div class="not-prose mt-8">
      <h3 class="text-lg font-bold mb-3">Experience</h3>
      <dl class="space-y-2 text-sm text-main">
        <div class="flex gap-3">
          <dt class="shrink-0 w-48 font-semibold">Nine Dots Consulting</dt>
          <dd class="opacity-70">Associate Technical Developer · 2025–present</dd>
        </div>
        <div class="flex gap-3">
          <dt class="shrink-0 w-48 font-semibold">Nusantara Food Ontology</dt>
          <dd class="opacity-70">Backend Developer (Freelance) · 2024–2025</dd>
        </div>
        <div class="flex gap-3">
          <dt class="shrink-0 w-48 font-semibold">Telkom Indonesia</dt>
          <dd class="opacity-70">Backend Developer Intern · 2023–2024</dd>
        </div>
        <div class="flex gap-3">
          <dt class="shrink-0 w-48 font-semibold">Telkom Indonesia</dt>
          <dd class="opacity-70">Backend Stream — DBT Program · 2023</dd>
        </div>
        <div class="flex gap-3">
          <dt class="shrink-0 w-48 font-semibold">Informatics Laboratory</dt>
          <dd class="opacity-70">Practicum Assistant · 2022–2023</dd>
        </div>
        <div class="flex gap-3">
          <dt class="shrink-0 w-48 font-semibold">Proclub Telkom University</dt>
          <dd class="opacity-70">President (2023–2024) · Lead Software Engineer (2022–2023)</dd>
        </div>
      </dl>
    </div>

    <div class="not-prose mt-8">
      <h3 class="text-lg font-bold mb-3">Education</h3>
      <dl class="space-y-1 text-sm text-main">
        <div class="flex gap-3">
          <dt class="shrink-0 w-48 font-semibold">Telkom University</dt>
          <dd class="opacity-70">B.CompSci · GPA 3.76/4.00 Cum Laude · 2020–2024</dd>
        </div>
      </dl>
      <ul class="mt-3 space-y-1 text-sm opacity-70 list-none pl-0">
        <li>Published research on HTTP versions vs. backend application performance</li>
        <li>Active in student organisations, university labs, tech communities, and programming competitions</li>
        <li>Always exploring — whether it's a new tool, a side project, or a rabbit hole worth going down</li>
      </ul>
    </div>

    <div class="not-prose mt-8">
      <h3 class="text-lg font-bold mb-3">Toolbox</h3>
      <dl class="space-y-2 text-sm text-main">
        <div class="flex gap-2">
          <dt class="font-semibold shrink-0 w-40">Languages</dt>
          <dd>TypeScript, JavaScript, Go, Python, Java, C/C++, Bash, X++</dd>
        </div>
        <div class="flex gap-2">
          <dt class="font-semibold shrink-0 w-40">Frameworks</dt>
          <dd>Node.js, Express, Laravel, Flask, React, React Native, LangChain</dd>
        </div>
        <div class="flex gap-2">
          <dt class="font-semibold shrink-0 w-40">Databases</dt>
          <dd>PostgreSQL, MySQL, Microsoft SQL Server, MongoDB, Redis</dd>
        </div>
        <div class="flex gap-2">
          <dt class="font-semibold shrink-0 w-40">Cloud &amp; DevOps</dt>
          <dd>
            GCP, Hyperledger Fabric, Docker, <a
              href="https://github.com/hidayattaufiqur/nix-config"
              target="_blank"
              rel="noopener noreferrer"
              class="prose-link">Nix</a
            >, GitHub Actions, Azure DevOps
          </dd>
        </div>
        <div class="flex gap-2">
          <dt class="font-semibold shrink-0 w-40">Monitoring &amp; Servers</dt>
          <dd>Prometheus, Grafana, Nginx</dd>
        </div>
        <div class="flex gap-2">
          <dt class="font-semibold shrink-0 w-40">Specialized</dt>
          <dd>
            D365FO, SSRS, LCS, Linux, <a
              href="https://github.com/hidayattaufiqur/cracked.nvchad"
              target="_blank"
              rel="noopener noreferrer"
              class="prose-link">Neovim</a
            >, Postman, Notion, AI/Agents
          </dd>
        </div>
      </dl>
    </div>

    <section class="mt-10">
      <h3 class="text-lg font-bold mb-2">Photography</h3>
      <p class="text-lg">
        I also enjoy photography — capturing everyday moments, places, and light. Browse a selection of my shots
        <a href="/photography" aria-label="See my photography gallery" class="prose-link">here</a>.
      </p>
    </section>

    <p class="text-lg mt-6">
      Interested in my background? Check my
      <b
        ><a
          href="https://drive.google.com/file/d/1Yn0jkXZOlD8YEyRTPs98w9wZvFTvDOYt/view?usp=sharing"
          target="_blank"
          aria-label="View my CV/resume"
          class="prose-link">CV/resume</a
        ></b
      >.
    </p>

    <section class="mt-10">
      <p class="text-lg">Let's connect:</p>
      <div class="flex gap-x-4 gap-y-2 flex-wrap mt-4">
        {
          siteConfig.socialLinks.map((link) => (
            <a
              aria-label={link.text}
              href={link.href}
              target="_blank"
              class="prose-link text-blue-500 hover:text-blue-700 transition-colors duration-200 flex items-center p-2 rounded hover:bg-gray-100 dark:hover:bg-gray-700"
            >
              <i class:list={[link.icon]} class="text-xl mr-2" />
              {link.text}
            </a>
          ))
        }
      </div>
      <p class="mt-6 text-lg">
        Or email me at
        <a
          class="text-blue-500 hover:text-blue-700 transition-colors duration-200"
          aria-label={siteConfig.email}
          href={`mailto:${siteConfig.email}`}
        >
          {siteConfig.email}
        </a>
      </p>
    </section>
  </article>
</BaseLayout>
