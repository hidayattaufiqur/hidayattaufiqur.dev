{
  "name": "astro-theme-vitesse",
  "type": "module",
  "version": "1.1.0",
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "astro dev --host",
    "build": "node scripts/gen-woff2.js && astro build && node scripts/postbuild.js",
    "preview": "astro preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "bumpp"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/vue": "^6.0.1",
    "@github/copilot": "^1.0.39",
    "@unocss/astro": "^66.0.0",
    "@unocss/reset": "^66.0.0",
    "astro": "^6.1.10",
    "nprogress": "^0.2.0",
    "unocss": "^66.0.0",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.16.0",
    "@iconify-json/logos": "^1.2.9",
    "@iconify-json/simple-icons": "^1.2.50",
    "@iconify/json": "^2.2.204",
    "@types/lodash-es": "^4.17.12",
    "@types/nprogress": "^0.2.3",
    "@vueuse/core": "^10.9.0",
    "bumpp": "^11.0.1",
    "eslint": "^8.57.0",
    "eslint-plugin-astro": "^1.2.0",
    "eslint-plugin-format": "^0.1.1",
    "lint-staged": "^15.2.2",
    "lodash-es": "^4.18.1",
    "prettier-plugin-astro": "^0.13.0",
    "simple-git-hooks": "^2.11.1",
    "ttf2woff2": "^8.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "npm run lint:fix"
  }
}
